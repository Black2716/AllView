<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 读取 Markdown 中引用的本地图片；Android 13 起改用 READ_MEDIA_IMAGES -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!--
        仅 DOCX 的 WebView 渲染需要：WebView 在初始化时会检查 INTERNET 权限，
        缺少它会直接抛 SecurityException（实测崩溃）。
        实际不会产生任何网络流量：
          - settings.blockNetworkLoads 由页面级 networkSecurityConfig 兜底
          - 所有图片都是 base64 内嵌，HTML 完全自包含
          - shouldOverrideUrlLoading 一律返回 true，拦截任何跳转
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AllView">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AllView"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                从文件管理器 / 其他 App 直接「用 AllView 打开」。
                只声明 Markdown 的两种 MIME，不抢 text/plain ——否则所有 .txt
                都会出现在「打开方式」里，对只读 Markdown 阅读器是噪音。
            -->
            <intent-filter android:label="@string/open_with_md">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="text/html" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>
    </application>

</manifest>
